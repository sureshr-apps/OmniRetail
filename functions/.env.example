# Used by the Phase 2 username/password bridge when it calls Firebase Auth's
# signInWithPassword API. This is Firebase web configuration, not a service key.
OMNIRETAIL_WEB_API_KEY="replace-me"

# Cloud SQL PostgreSQL IAM database username for the Functions runtime.
# Use the runtime service-account email without the .gserviceaccount.com suffix.
CLOUD_SQL_IAM_USER="runtime-service-account@project.iam"

# Keep false until the Web app is registered with Firebase App Check. Set true
# for deployed environments immediately after the reCAPTCHA Enterprise key is
# configured and the browser receives VITE_FIREBASE_APP_CHECK_SITE_KEY.
AUTH_ENFORCE_APP_CHECK="false"
